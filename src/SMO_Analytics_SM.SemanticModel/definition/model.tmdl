model Model
	culture: en-US
	collation: Latin1_General_100_BIN2_UTF8
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	directLakeBehavior: directLakeOnly
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0
annotation PBI_QueryOrder = ["DatabaseQuery"]
annotation PBI_ProTooling = ["WebModelingEdit","RemoteModeling"]

ref table 'Semantic Model Optimization Overview'
ref table 'Semantic Model Optimization Opportunities'
ref table 'Semantic Model Optimization Recommendations'
ref table 'Semantic Model Optimization Findings'
ref table 'Semantic Model Column Storage'
ref table 'Opportunity Recommendation Links'
ref table 'Opportunity Finding Links'
ref table Metrics

relationship overview_opportunities
	fromColumn: 'Semantic Model Optimization Opportunities'[semantic_model_id]
	toColumn: 'Semantic Model Optimization Overview'[semantic_model_id]

relationship overview_recommendations
	fromColumn: 'Semantic Model Optimization Recommendations'[semantic_model_id]
	toColumn: 'Semantic Model Optimization Overview'[semantic_model_id]

relationship overview_findings
	fromColumn: 'Semantic Model Optimization Findings'[semantic_model_id]
	toColumn: 'Semantic Model Optimization Overview'[semantic_model_id]

relationship overview_column_storage
	fromColumn: 'Semantic Model Column Storage'[semantic_model_id]
	toColumn: 'Semantic Model Optimization Overview'[semantic_model_id]

relationship opportunity_recommendation_bridge
	fromColumn: 'Opportunity Recommendation Links'[opportunity_id]
	toColumn: 'Semantic Model Optimization Opportunities'[opportunity_id]

relationship opportunity_finding_bridge
	fromColumn: 'Opportunity Finding Links'[opportunity_id]
	toColumn: 'Semantic Model Optimization Opportunities'[opportunity_id]

ref cultureInfo en-US
