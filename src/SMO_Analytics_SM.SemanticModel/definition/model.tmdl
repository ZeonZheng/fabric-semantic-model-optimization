model Model
	culture: en-US
	collation: Latin1_General_100_BIN2_UTF8
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	directLakeBehavior: directLakeOnly
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0
annotation PBI_QueryOrder = ["DatabaseQuery"]
annotation PBI_ProTooling = ["WebModelingEdit","RemoteModeling"]

ref table smopt_scan_run
ref table smopt_model_scan
ref table smopt_finding
ref table smopt_dim_model
ref table Metrics

ref cultureInfo en-US

