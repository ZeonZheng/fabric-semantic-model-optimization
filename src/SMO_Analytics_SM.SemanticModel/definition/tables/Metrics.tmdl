table Metrics
	lineageTag: 0cf621e7-94ae-437e-827a-e2c35635a284

	measure 'Models scanned' = COALESCE(DISTINCTCOUNT(semantic_models[semantic_model_id]), 0)
		formatString: #,0
		displayFolder: Overview

	measure 'Issue is complete' =
			IF(
				NOT ISBLANK(SELECTEDVALUE(semantic_model_optimization_opportunities[priority_band])) &&
				NOT ISBLANK(SELECTEDVALUE(semantic_model_optimization_opportunities[actionability_status])),
				1,
				0
			)
		formatString: #,0
		displayFolder: Report experience

	measure 'Total opportunities' =
			COALESCE(
				COUNTROWS(
					FILTER(
						semantic_model_optimization_opportunities,
						NOT ISBLANK(semantic_model_optimization_opportunities[priority_band]) &&
						NOT ISBLANK(semantic_model_optimization_opportunities[actionability_status])
					)
				),
				0
			)
		formatString: #,0
		displayFolder: Opportunities

	measure 'Recommendation is complete' =
			IF(
				NOT ISBLANK(SELECTEDVALUE(semantic_model_optimization_recommendations[why_it_matters])) &&
				NOT ISBLANK(SELECTEDVALUE(semantic_model_optimization_recommendations[recommended_action])) &&
				NOT ISBLANK(SELECTEDVALUE(semantic_model_optimization_recommendations[validation_method])) &&
				NOT ISBLANK(SELECTEDVALUE(semantic_model_optimization_recommendations[rollback_guidance])),
				1,
				0
			)
		formatString: #,0
		displayFolder: Report experience

	measure 'Total recommendations' =
			COALESCE(
				COUNTROWS(
					FILTER(
						semantic_model_optimization_recommendations,
						NOT ISBLANK(semantic_model_optimization_recommendations[why_it_matters]) &&
						NOT ISBLANK(semantic_model_optimization_recommendations[recommended_action]) &&
						NOT ISBLANK(semantic_model_optimization_recommendations[validation_method]) &&
						NOT ISBLANK(semantic_model_optimization_recommendations[rollback_guidance])
					)
				),
				0
			)
		formatString: #,0
		displayFolder: Recommendations

	measure 'Actionable recommendations' =
			COALESCE(
				CALCULATE(
					[Total recommendations],
					semantic_model_optimization_recommendations[actionability_status] = "ACTIONABLE"
				),
				0
			)
		formatString: #,0
		displayFolder: Recommendations

	measure 'Review required recommendations' =
			COALESCE(
				CALCULATE(
					[Total recommendations],
					semantic_model_optimization_recommendations[actionability_status] = "REVIEW_REQUIRED"
				),
				0
			)
		formatString: #,0
		displayFolder: Recommendations

	measure 'Total findings' = COALESCE(COUNTROWS(semantic_model_optimization_findings), 0)
		formatString: #,0
		displayFolder: Findings

	measure 'Suppressed findings' =
			COALESCE(
				CALCULATE(
					[Total findings],
					semantic_model_optimization_findings[actionability_status] = "SUPPRESSED"
				),
				0
			)
		formatString: #,0
		displayFolder: Findings

	measure 'High findings' =
			COALESCE(
				CALCULATE(
					[Total findings],
					semantic_model_optimization_findings[severity] IN { "HIGH", "CRITICAL", "ERROR" }
				),
				0
			)
		formatString: #,0
		displayFolder: Findings

	measure 'Visible evidence' = COALESCE(COUNTROWS(semantic_model_optimization_findings), 0)
		formatString: #,0
		displayFolder: Report experience

	measure 'Visible action evidence' =
			VAR ActionTitle = SELECTEDVALUE(semantic_model_optimization_recommendations[recommendation_title])
			VAR ActionOpportunity = SELECTEDVALUE(semantic_model_optimization_recommendations[opportunity_id])
			VAR RootCause =
				LOOKUPVALUE(
					semantic_model_optimization_opportunities[opportunity_title],
					semantic_model_optimization_opportunities[opportunity_id], ActionOpportunity
				)
			RETURN
				IF(
					ISBLANK(ActionTitle) || ActionTitle = RootCause,
					[Visible evidence],
					CALCULATE(
						[Visible evidence],
						TREATAS({ ActionTitle }, semantic_model_optimization_findings[rule_name])
					)
				)
		formatString: #,0
		displayFolder: Report experience

	measure 'Visible actions' =
			COALESCE(
				SUMX(
					VALUES(semantic_model_optimization_recommendations[recommendation_id]),
					IF(CALCULATE([Visible action evidence]) > 0, 1, 0)
				),
				0
			)
		formatString: #,0
		displayFolder: Report experience

	measure 'Columns analyzed' = COALESCE(COUNTROWS(semantic_model_column_storage), 0)
		formatString: #,0
		displayFolder: Storage

	measure 'Total column storage MB' = COALESCE(DIVIDE(SUM(semantic_model_column_storage[total_size_bytes]), 1048576), 0)
		formatString: #,0.00
		displayFolder: Storage

	measure 'Estimated saving MB low' = COALESCE(DIVIDE(SUM(semantic_model_optimization_findings[estimated_saving_bytes_low]), 1048576), 0)
		formatString: #,0.00
		displayFolder: Benefits

	measure 'Estimated saving MB high' = COALESCE(DIVIDE(SUM(semantic_model_optimization_findings[estimated_saving_bytes_high]), 1048576), 0)
		formatString: #,0.00
		displayFolder: Benefits

	measure 'Latest analysis at' = MAX(semantic_model_optimization_overview[analysis_completed_at])
		formatString: General Date
		displayFolder: Overview

	measure 'Selected analysis context' =
			VAR WorkspaceName = SELECTEDVALUE(semantic_models[workspace_name], "All workspaces")
			VAR ModelName = SELECTEDVALUE(semantic_models[semantic_model_name], "All semantic models")
			VAR AnalysisId = SELECTEDVALUE(semantic_models[latest_analysis_id], "Multiple latest analyses")
			VAR AnalysisStatus = SELECTEDVALUE(semantic_models[latest_analysis_status], "Mixed analysis status")
			VAR AnalysisAt = SELECTEDVALUE(semantic_models[latest_analysis_at])
			VAR AnalysisTimestamp = IF(NOT ISBLANK(AnalysisAt), FORMAT(AnalysisAt, "yyyy-mm-dd HH:mm"), "No completed analysis")
			VAR ScannerVersion = SELECTEDVALUE(semantic_models[scanner_version], "Multiple scanner versions")
			RETURN
				WorkspaceName & " · " & ModelName & UNICHAR(10) &
				AnalysisStatus & " · " & AnalysisTimestamp & " · Scanner " & ScannerVersion & UNICHAR(10) &
				AnalysisId
		displayFolder: Report experience

	measure 'Severity color' =
			SWITCH(
				SELECTEDVALUE(semantic_model_optimization_findings[severity]),
				"CRITICAL", "#A4262C", "ERROR", "#A4262C", "HIGH", "#D13438",
				"WARNING", "#F59E0B", "MEDIUM", "#F59E0B", "INFO", "#0078D4",
				"LOW", "#107C10", "#605E5C"
			)
		displayFolder: Report experience

	measure 'Risk color' =
			SWITCH(
				SELECTEDVALUE(semantic_model_optimization_recommendations[change_risk]),
				"HIGH", "#D13438", "MEDIUM", "#F59E0B", "LOW", "#107C10", "#605E5C"
			)
		displayFolder: Report experience

	measure 'Actionability color' =
			SWITCH(
				SELECTEDVALUE(semantic_model_optimization_recommendations[actionability_status]),
				"ACTIONABLE", "#D9EAD3", "REVIEW_REQUIRED", "#FCE8B2",
				"INFORMATIONAL", "#D9EAF7", "SUPPRESSED", "#E5E7EB", "#FFFFFF"
			)
		displayFolder: Report experience
