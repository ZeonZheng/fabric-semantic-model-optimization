{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.5.0/schema.json",
  "name": "top_columns",
  "position": {
    "x": 360,
    "y": 30,
    "z": 2000,
    "height": 220,
    "width": 870,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Semantic Model Column Storage"
                    }
                  },
                  "Property": "column_name"
                }
              },
              "queryRef": "Semantic Model Column Storage.column_name",
              "nativeQueryRef": "Column",
              "displayName": "Column"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "Total column storage MB"
                }
              },
              "queryRef": "Metrics.Total column storage MB",
              "nativeQueryRef": "Storage MB",
              "displayName": "Storage MB"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Largest columns by storage'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
